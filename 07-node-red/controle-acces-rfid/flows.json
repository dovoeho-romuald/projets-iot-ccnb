        "name": "verification_acces",
        "func": "var rfid_address = msg.payload;\n\nif(rfid_address == \"198426b9\" || rfid_address == \"3c162d31\" || rfid_address == \"37889e5f\")\n{\n    msg.payload = \"ACCESS GRANTED\";\n}\nelse\n{\n    msg.payload = \"ACCESS DENIED\";\n    msg.rfid_address = rfid_address;\n}\n\nlet newPayload = msg.payload; // Fetch Payload\n\nmsg.payload = [rfid_address, newPayload];\nmsg.topic = \"INSERT INTO register_address (card_id, acces) VALUES (?, ?)\"; // SQL Query\nreturn msg;",
